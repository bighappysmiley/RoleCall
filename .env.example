# RoleCall — copy to .env.local and fill from Neon / agent handoff

# Postgres pooled connection string
DATABASE_URL=

# Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional identifiers
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Object Storage (Neon S3-compatible; Ohio / Frankfurt only on free beta)
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
