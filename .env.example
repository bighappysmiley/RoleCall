# Names of secrets for Netlify → Environment variables.
# This app is hosted in the cloud. There is no Mac project folder.

# Neon Postgres (pooled — used by the app)
DATABASE_URL=

# Neon Postgres (direct — used by drizzle-kit migrate)
DATABASE_URL_UNPOOLED=

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public site URL for password-reset links and Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true on the RoleCall Preview Netlify site (optional; also auto-detected)
NEXT_PUBLIC_ROLECALL_PREVIEW=

# Stripe test mode (free). Do not put live keys here unless you mean to charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects the daily promotion-expiry job (Netlify scheduled function)
CRON_SECRET=
